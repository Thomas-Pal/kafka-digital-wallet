{
  "name": "kafka-digital-wallet",
  "private": true,
  "workspaces": ["apps/*", "services/*"],
  "scripts": {
    "bootstrap": "npm i -ws",
    "up:kafka": "podman compose -f infra/compose/podman-compose.yml up -d",
    "down:kafka": "podman compose -f infra/compose/podman-compose.yml down -v",
    "topics": "node infra/kafka/init-topics.js",
    "start:services": "node infra/run.mjs services",
    "svc:orchestrator": "NODE_ENV=dev tsx services/orchestration-api/index.ts",
    "svc:gatekeeper": "NODE_ENV=dev tsx services/gatekeeper/index.ts",
    "svc:dwp": "NODE_ENV=dev tsx services/dwp-api/index.ts",
    "wallet": "npm --prefix apps/wallet run dev",
    "portal": "npm --prefix apps/dwp-portal run dev",
    "dev": "node infra/run.mjs dev",
    "stop": "npm run down:kafka"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
