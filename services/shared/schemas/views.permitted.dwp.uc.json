{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Permitted View - DWP UC",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "citizenId", "caseId", "caseType", "evidence", "reason", "grantedAt"],
  "properties": {
    "eventId": { "type": "string" },
    "citizenId": { "type": "string" },
    "caseId": { "type": "string" },
    "caseType": { "type": "string", "enum": ["UC"] },
    "evidence": {
      "type": "object",
      "required": ["employment"],
      "properties": {
        "employment": { "type": "object" },
        "health": { "type": "object" }
      }
    },
    "reason": { "type": "string" },
    "grantedAt": { "type": "string", "format": "date-time" }
  }
}
